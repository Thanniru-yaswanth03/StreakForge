# ========================================================
# StreakForge Environment Configuration Template
# Copy this file to .env in local environments
# ========================================================

# Environment Mode
NODE_ENV=development

# Server API Configuration
PORT=4000
API_BASE_URL=http://localhost:4000

# Web Application
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Persistence (MongoDB)
MONGODB_URI=mongodb://localhost:27017/streakforge

# Security & Cryptography
# 64-char hex string (32 bytes) for AES-256-GCM encryption
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=7d

# GitHub OAuth Application
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# Allowed CORS Origins (comma separated)
CORS_ORIGIN=http://localhost:3000,chrome-extension://*

# Structured Logging
LOG_LEVEL=info

