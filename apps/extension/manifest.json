{
  "manifest_version": 3,
  "name": "StreakForge LeetCode Sync",
  "version": "1.0.0",
  "description": "Authentic LeetCode activity synchronization from verified accepted submissions to your GitHub repositories.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetcode.cn/*",
    "https://*.streakforge.dev/*",
    "https://streakforge.dev/*",
    "https://*.onrender.com/*",
    "https://*.vercel.app/*",
    "https://*.railway.app/*",
    "https://*.trycloudflare.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "StreakForge LeetCode Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*"
      ],
      "js": [
        "src/content/leetcode-interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*"
      ],
      "js": [
        "src/content/leetcode-observer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.streakforge.dev/*",
        "https://streakforge.dev/*",
        "https://*.onrender.com/*",
        "https://*.vercel.app/*",
        "https://*.railway.app/*",
        "https://*.trycloudflare.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "src/content/web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
