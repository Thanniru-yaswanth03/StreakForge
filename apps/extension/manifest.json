{
  "manifest_version": 3,
  "name": "StreakForge — LeetCode to GitHub Sync",
  "version": "1.0.0",
  "description": "Authentic coding activity synchronization from LeetCode to your GitHub repositories.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetcode.cn/*",
    "http://localhost:4000/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "StreakForge"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "src/content/leetcode-observer.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}