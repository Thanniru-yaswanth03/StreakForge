# ========================================================
# StreakForge Production Environment Configuration Template
# Use this template when configuring environment variables on
# Render, Railway, Fly.io, Vercel, or custom Docker hosts.
# ========================================================

# Runtime Mode
NODE_ENV=production

# Server Port (Render/Railway sets PORT automatically, defaults to 4000)
PORT=4000

# Central API Domain (Replace with your actual backend production domain)
API_BASE_URL=https://api.streakforge.dev

# Web Frontend URL (Replace with your actual frontend domain)
WEB_APP_URL=https://streakforge.dev
NEXT_PUBLIC_APP_URL=https://streakforge.dev
NEXT_PUBLIC_API_URL=https://api.streakforge.dev/api/v1

# MongoDB Connection String (MongoDB Atlas M0 Free Cluster or Replica Set with TLS/SSL)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/streakforge?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://streakforge_app:REPLACE_WITH_SECURE_PASSWORD@cluster0.mongodb.net/streakforge?retryWrites=true&w=majority

# Cryptographic Master Key (AES-256-GCM encryption for stored GitHub OAuth tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hexadecimal characters
ENCRYPTION_MASTER_KEY=REPLACE_WITH_64_CHAR_HEX_KEY

# JSON Web Token Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REPLACE_WITH_HIGH_ENTROPY_BASE64_JWT_SECRET
JWT_EXPIRES_IN=7d

# GitHub OAuth Application Credentials
# Create at: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL must be: https://api.streakforge.dev/api/v1/auth/github/callback
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=https://api.streakforge.dev/api/v1/auth/github/callback
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# CORS Allowed Origins (Comma-separated exact origins)
# Include your frontend domain and chrome extension origin
CORS_ORIGIN=https://streakforge.dev,chrome-extension://REPLACE_WITH_STORE_EXTENSION_ID

# Structured Logging
LOG_LEVEL=info

